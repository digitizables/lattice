# Operator UI: Vite build served by nginx, API proxied to teamserver.
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY client/ui/web/package.json client/ui/web/package-lock.json ./client/ui/web/
WORKDIR /src/client/ui/web
RUN npm ci
WORKDIR /src
COPY docs ./docs
COPY client/ui/web ./client/ui/web
WORKDIR /src/client/ui/web
RUN npm run build

FROM nginx:1.27-alpine
COPY packager/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/client/ui/web/dist /usr/share/nginx/html
EXPOSE 80
