FROM node:22-alpine AS build
WORKDIR /web
COPY client/ui/web/package.json client/ui/web/package-lock.json* ./
RUN npm install
COPY client/ui/web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY packager/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
