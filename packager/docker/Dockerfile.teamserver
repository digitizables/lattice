# Placeholder until the teamserver binary exists.
# Build will fail until server/cmd/teamserver is implemented.
FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/teamserver ./server/cmd/teamserver

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/teamserver /teamserver
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/teamserver"]
